# MISP Connection Settings
MISP_URL=https://your-misp.example
MISP_KEY=
MISP_VERIFY_CERT=False

# Filter Settings
# Only process events owned by this organization ID (NCSA is 1)
OWNER_ORG_ID=1

# Safety Controls
# Set DRY_RUN=False to actually disable and publish events. Keep True for testing.
DRY_RUN=True

# Threat Intelligence Enrichment API Keys
# Enrichment providers (see README). A provider without its URL/key is skipped.
# A: IOC API base URL + token (cookie access_token)
ENRICH_A_URL=
ENRICH_A_TOKEN=
# B: URL lookup endpoint + Auth-Key
ENRICH_B_URL=
ENRICH_B_KEY=
# C: hash lookup endpoint + Auth-Key
ENRICH_C_URL=
ENRICH_C_KEY=
# D: indicator API base URL; key optional, header name configurable
ENRICH_D_URL=
ENRICH_D_KEY=
ENRICH_D_KEY_HEADER=X-API-Key

# Aging Thresholds (in Days)
IP_AGE_THRESHOLD=30
DOMAIN_AGE_THRESHOLD=90
URL_AGE_THRESHOLD=90
HASH_AGE_THRESHOLD=180
DEFAULT_AGE_THRESHOLD=90

# Performance and Rate Limiting Settings
MAX_CHECKS_PER_RUN=200
API_DELAY_SECONDS=1.0

# Logging Directory
LOG_FILE=logs/misp_cleanup.log


# Action for whitelisted IOCs: 'disable' (set to_ids=False) or 'remove' (delete attribute entirely)
WHITELIST_ACTION=disable

# Whitelist of popular/benign IOCs (automatically sets to_ids=False / deletes them depending on WHITELIST_ACTION)
WHITELIST_IOCS=

# Clean File Metadata From a vendor
CLEAN_HASH_URL=
CLEAN_HASH_API_KEY=
# Label written into IDS-disable comments for clean-hash hits
CLEAN_HASH_LIST_NAME=Clean hash feed
